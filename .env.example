# NC Court Digest Configuration
# Copy this file to .env and fill in your values

# Required: Anthropic API key for AI summary generation
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: SMTP settings for email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com

# Optional: Set to 'true' for TLS (port 465)
SMTP_SECURE=false

# Optional: Email recipients (comma-separated)
# Default: mswigley@wardandsmith.com
EMAIL_RECIPIENTS=mswigley@wardandsmith.com

# Optional: Database file path
# Default: ./data/opinions.db
DB_PATH=./data/opinions.db

# Optional: Set to 'false' to see browser during scraping (for debugging)
BROWSER_HEADLESS=true
